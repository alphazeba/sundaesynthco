---
import { parseFile } from 'music-metadata';
import path from 'node:path';

interface AudioFile {
    title: string;
    subtitle: string;
    src: string;
}
interface Props {
    id: string;
    files: AudioFile[];
}
const { id, files }  = Astro.props;

function formatDuration(seconds: number): string {
    const mins = Math.floor(seconds / 60);
    const secs = Math.round(seconds % 60);
    return `${mins}:${secs.toString().padStart(2, '0')}`;
}

// Read audio duration at build time from files in the public/ directory
const filesWithDuration = await Promise.all(
    files.map(async (file) => {
        let duration = '';
        try {
            const filePath = path.join(process.cwd(), 'public', file.src);
            const metadata = await parseFile(filePath);
            if (metadata.format.duration) {
                duration = formatDuration(metadata.format.duration);
            }
        } catch (err) {
            console.warn(`Could not read duration for ${file.src}:`, err);
        }
        return { ...file, duration };
    })
);
---
<div class="audio-card" data-audio-card data-player-id={id}>
    <div class="audio-list">
        {filesWithDuration.map((file, index) => (
	<div class:list={["audio-item", { active: index === 0 }]} data-src={file.src}>
	    <span class="audio-item-title">{index + 1}. {file.title} - {file.subtitle}</span>
                {file.duration && <span class="audio-item-duration">{file.duration}</span>}
            </div>
        ))}
    </div>
    <div>
	<audio id={id} class="audio-player" src={files[0].src} controls loading="lazy"></audio>
    </div>
</div>

<script>
    document.querySelectorAll<HTMLElement>('[data-audio-card]').forEach((card) => {
        const playerId = card.getAttribute('data-player-id');
        if (!playerId) return;
        const player = document.getElementById(playerId) as HTMLAudioElement | null;
        if (!player) return;

        card.querySelectorAll<HTMLElement>('.audio-item').forEach((item) => {
            item.addEventListener('click', () => {
                const src = item.getAttribute('data-src');
                if (!src) return;
                player.src = src;
                player.play();

                card.querySelectorAll('.audio-item').forEach((el) => el.classList.remove('active'));
                item.classList.add('active');
            });
        });
    });
</script>

<style>
    .audio-card {
        border: 2px solid var(--dark);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
	background-color: var(--yellow-shadow);
	color: var(--dark);
	overflow: hidden;
    }
    .audio-list {
        display: flex;
        flex-direction: column;
    }
    .audio-item {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        background: none;
        border: none;
        cursor: pointer;
        color: inherit;
        font: inherit;
	padding: 0 1em 0 1em;
    }
    .audio-item:hover {
	background-color: var(--pink);
    }
    .audio-item.active {
	background-color: var(--pink);
    }
    .audio-player {
        display: block;
        width: 100%;
    }
    .audio-item-title {
        font-size: 0.9rem;
    }
    .audio-item-duration {
        font-size: 0.85rem;
        opacity: 0.7;
        font-variant-numeric: tabular-nums;
    }
</style>
