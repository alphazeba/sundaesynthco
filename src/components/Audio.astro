---
interface AudioFile {
    title: string;
    src: string;
}
interface Props {
    id: string;
    files: AudioFile[];
}
const { id, files }  = Astro.props;
---
<div class="audio-card" data-audio-card data-player-id={id}>
    <div class="audio-list">
        {files.map((file, index) => (
	<div class:list={["audio-item", { active: index === 0 }]} data-src={file.src}>
                <span class="audio-item-title">{file.title}</span>
            </div>
        ))}
    </div>
    <div>
	<audio id={id} class="audio-player" src={files[0].src} controls loading="lazy"></audio>
    </div>
</div>

<script>
    document.querySelectorAll<HTMLElement>('[data-audio-card]').forEach((card) => {
        const playerId = card.getAttribute('data-player-id');
        if (!playerId) return;
        const player = document.getElementById(playerId) as HTMLAudioElement | null;
        if (!player) return;

        card.querySelectorAll<HTMLElement>('.audio-item').forEach((item) => {
            item.addEventListener('click', () => {
                const src = item.getAttribute('data-src');
                if (!src) return;
                player.src = src;
                player.play();

                card.querySelectorAll('.audio-item').forEach((el) => el.classList.remove('active'));
                item.classList.add('active');
            });
        });
    });
</script>

<style>
    .audio-card {
        border: 2px solid var(--dark);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
	background-color: var(--yellow-shadow);
	color: var(--dark);
	overflow: hidden;
    }
    .audio-list {
        display: flex;
        flex-direction: column;
    }
    .audio-item {
        display: flex;
        flex-direction: column;
        background: none;
        border: none;
        cursor: pointer;
        color: inherit;
        font: inherit;
        width: 100%;
    }
    .audio-item:hover {
	background-color: var(--pink);
    }
    .audio-item.active {
	background-color: var(--pink);
    }
    .audio-player {
        display: block;
        width: 100%;
    }
    .audio-item-title {
        font-size: 0.9rem;
        text-align: center;
    }
</style>
