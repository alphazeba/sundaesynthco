---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import Audio from '@/components/Audio.astro';
import { Content } from '@/content/scratchbaby_body.md';

import titleScreenshotImg from '@/assets/scratchbaby-screenshot-crop.png';
import logoImg from '@/assets/scratchbabylogo.png';
---

<Layout title="Scratch Baby">
	<main class="product-page">
		<h1 class="sr-only">Scratch Baby</h1>

		<div class="screenshot-container">
			<Image src={logoImg} alt="" class="peek-logo" aria-hidden="true" />
			<div class="screenshot-wrapper">
				<Image
					src={titleScreenshotImg}
					alt="Scratch Baby plugin interface showing waveform display, slice controls, and per-voice knobs"
					class="screenshot"
					priority
				/>
			</div>
		</div>

		<h1 id="subtitle">Playable Turntable Sampler</h1>
		<div class="content-section">
			<div class="video-wrapper">
				<iframe
					src="https://www.youtube.com/embed/PLd_091E9-0?si=kvYCM0v6Adwz33vM"
					title="Scratch Baby demo"
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				></iframe>
			</div>
			<Content />
		</div>
		<h1 id="Examples">Examples</h1>
		<div class="content-section">
		    <Audio
			id="onlyone"
			files={[
			    { title: "Alright!", subtitle: "Murder a sample", src: "/audio/alright.mp3" },
			    { title: "Ghosty", subtitle: "Emote a drone", src: "/audio/ghosty2.mp3" },
			    { title: "Horns", subtitle: "Hip-hop?", src: "/audio/horns.mp3" },
			    { title: "Heavyweight", subtitle: "Lofi jam", src: "/audio/heavyweight.mp3" },
			]}
		    />
		</div>
		<h1 id="buy">What's next?</h1>
		<div class="buttons">
			<button class="btn btn-trial" onclick="Moonbase.download_product({ product_id: 'scratch-baby' })">
				Download Trial
			</button>
			<button class="btn btn-purchase" disabled onclick="Moonbase.add_to_cart({ product_id: 'scratch-baby', show_cart: true })">
				Purchase — <span data-moonbase-render="product.scratch-baby.price">TBD</span>
			</button>
			<a class="btn" href="/scratchbaby/manual">
			    Manual
			</a>
			<button class="btn">
			    Feedback
			</button>
		</div>
	</main>
</Layout>
<style>
	.peek-logo {
		position: absolute;
		bottom: 25%;
		left: 0;
		transform: translate(0%, 50%);
		width: 20vw;
		max-width: 8em;
		height: auto;
		z-index: 0;
		transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.screenshot-container:hover .peek-logo {
		transform: translate(-75%, 50%);
	}

	.screenshot-wrapper {
		position: relative;
		z-index: 1;
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
		border: 2px solid var(--dark);
		box-shadow:
			4px 4px 0px var(--yellow-shadow);
	}

	.screenshot {
		width: 100%;
		height: auto;
		display: block;
	}

	.video-wrapper {
		float: left;
		width: min(250px, 100%);
		aspect-ratio: 9 / 16;
		margin: 0 3rem 2rem 0;
		border-radius: 12px;
		overflow: hidden;
		border: 2px solid var(--dark);
		box-shadow:
			4px 4px 0px var(--yellow-shadow);
	}

	.video-wrapper iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	.content-section {
		max-width: 900px;
		width: 100%;
		margin-bottom: 3rem;
		line-height: 1.75;
	}

	.content-section::after {
		content: '';
		display: table;
		clear: both;
	}

	.content-section p {
		margin: 0 0 1.25rem;
		font-size: 1.1rem;
		color: var(--text-body);
	}

	.buttons {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 2rem;
		width: 100%;
		clear: both;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		box-sizing: border-box;
		padding: 1rem 2.5rem;
		margin: 0 1rem;
		border-radius: 8px;
		font-size: 1.1rem;
		font-weight: 700;
		line-height: 1;
		font-family: inherit;
		text-decoration: none;
		border: none;
		cursor: pointer;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
		flex: 1;
		min-width: 15em;
		max-width: 20em;

		background: var(--pink);
		color: var(--dark);
		border: 2px solid var(--dark);
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px var(--btn-shadow);
	}
	.btn:disabled {
	    background: var(--darkened-pink);
	    cursor: default;
	}
	.btn:disabled:hover {
	    transform: none;
	    box-shadow: none;
	}

	.btn-purchase {
		position: relative;
		overflow: hidden;
	}
	.btn-purchase::after {
		content: "coming soon";
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-30%, -50%) rotate(30deg);
		background: var(--text-body);
		color: var(--dark);
		font-weight: 700;
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.35rem 0;
		width: 110%;
		text-align: center;
		white-space: nowrap;
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
		border-top: 2px solid var(--dark);
		border-bottom: 2px solid var(--dark);
	}

	@media (max-width: 500px) {
		.video-wrapper {
			float: none;
			margin: 0 auto 2rem;
		}
	}
</style>
