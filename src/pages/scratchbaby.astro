---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import scratchBabyImg from '../assets/scratchbaby-screenshot-crop.png';
import InstallMoonbase from '../components/InstallMoonbase.astro';
---

<Layout title="Scratch Baby">
	<main class="product-page">
		<button class="cart-icon" onclick="Moonbase.view_cart()" aria-label="Open cart">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<path d="M16 10a4 4 0 0 1-8 0"></path>
			</svg>
		</button>

		<h1 class="sr-only">Scratch Baby</h1>

		<div class="screenshot-container">
			<img src="/scratchbabylogo.png" alt="" class="peek-logo" aria-hidden="true" />
			<div class="screenshot-wrapper">
				<Image
					src={scratchBabyImg}
					alt="Scratch Baby plugin interface showing waveform display, slice controls, and per-voice knobs"
					class="screenshot"
					loading="eager"
				/>
			</div>
		</div>

		<p class="product-tagline">Playable Turntable Sampler</p>

		<div class="content-section">
			<div class="video-wrapper">
				<iframe
					src="https://www.youtube.com/embed/PLd_091E9-0?si=kvYCM0v6Adwz33vM"
					title="Scratch Baby demo"
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				></iframe>
			</div>
			<p>
			    Scratch Baby is your varispeed playground. At its core is a flexible system for designing and performing different playback-speed articulations to suit the way you want to play. Each key across the octave has its own controls for pitch, glide up, and glide down, giving you independent control over how the sample moves between speeds.
			</p>
			<p>
			    This gives you precise control over how the sample moves between speeds, letting you create everything from sharp, scratch-like movements to smooth tape-stop-style transitions and expressive pitch bends. Instead of relying on automation curves or manually editing playback speed, you can perform these articulations directly from your keyboard or MIDI controller. Every note becomes an opportunity to move through the sample in a different way, making speed itself part of the performance.
			</p>
			<p>
			    Scratch Baby is designed for producers, beatmakers, DJs, and sound designers who want a more physical and expressive relationship with their samples. Load up a vocal, drum hit, texture, loop, or any other sound, then play it like an instrument—jumping between speeds, dragging through the audio, reversing direction, and creating your own rhythmic and melodic movements. It takes the fundamental behavior of a record or tape being moved by hand and turns it into something you can configure, perform, and make your own.
			</p>
		</div>

		<div class="buttons">
			<button class="btn btn-trial" onclick="Moonbase.download_product({ product_id: 'scratch-baby' })">
				Download Trial
			</button>
		</div>
	</main>
	<InstallMoonbase/>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Shrikhand&display=swap');

	:root {
		--pink: #efa9da;
	}

	.product-page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 4rem 3rem;
		background:
			linear-gradient(180deg, rgba(45, 65, 80, 0.4) 0%, rgba(30, 50, 65, 0.6) 100%),
			url('/sky_background.jpg') center / cover no-repeat;
		background-color: #1e3241;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		color: #e8e0d4;
	}

	.cart-icon {
		position: fixed;
		top: -10px;
		right: 1.5rem;
		z-index: 100;
		background: var(--pink);
		color: #1a2a35;
		border: 2px solid #1a2a35;
		border-radius: 0 0 8px 8px;
		width: 2.5rem;
		height: 3rem;
		padding-top: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: transform 0.15s ease;
	}

	.cart-icon:hover {
		transform: translateY(4px);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.product-tagline {
		font-family: 'Shrikhand', cursive;
		font-size: clamp(1.5rem, 4vw, 2.5rem);
		color: var(--pink);
		margin: 0 0 1.5rem;
		font-weight: 400;
		text-align: center;
	}

	.screenshot-container {
		position: relative;
		width: 100%;
		max-width: 900px;
		margin-bottom: 1rem;
	}

	.peek-logo {
		position: absolute;
		bottom: 25%;
		left: 0;
		transform: translate(0%, 50%);
		width: 20vw;
		max-width: 8em;
		height: auto;
		z-index: 0;
		transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.screenshot-container:hover .peek-logo {
		transform: translate(-75%, 50%);
	}

	.screenshot-wrapper {
		position: relative;
		z-index: 1;
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
		border: 2px solid #1a2a35;
		box-shadow:
			4px 4px 0px #dfc47b;
	}

	.screenshot {
		width: 100%;
		height: auto;
		display: block;
	}

	.video-wrapper {
		float: left;
		width: min(250px, 100%);
		aspect-ratio: 9 / 16;
		margin: 0 3rem 2rem 0;
		border-radius: 12px;
		overflow: hidden;
		border: 2px solid #1a2a35;
		box-shadow:
			4px 4px 0px #dfc47b;
	}

	.video-wrapper iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	.content-section {
		max-width: 900px;
		width: 100%;
		margin-bottom: 3rem;
		line-height: 1.75;
	}

	.content-section::after {
		content: '';
		display: table;
		clear: both;
	}

	.content-section p {
		margin: 0 0 1.25rem;
		font-size: 1.05rem;
		color: #fbf1da;
	}

	.buttons {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 2rem;
		width: 100%;
		clear: both;
	}

	.btn {
		display: inline-block;
		padding: 1rem 2.5rem;
		margin: 0 1rem;
		border-radius: 8px;
		font-size: 1.1rem;
		font-weight: 700;
		text-decoration: none;
		border: none;
		cursor: pointer;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
	}

	.btn-purchase {
		background: var(--pink);
		color: #1a2a35;
		border: 2px solid #1a2a35;
	}

	.btn-purchase:hover {
		background: var(--pink);
	}

	.btn-trial {
		background: transparent;
		color: var(--pink);
		border: 2px solid var(--pink);
	}

	.btn-trial:hover {
		background: rgba(239, 169, 218, 0.1);
	}

	@media (max-width: 500px) {
		.video-wrapper {
			float: none;
			margin: 0 auto 2rem;
		}
	}
</style>
