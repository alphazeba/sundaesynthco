---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import InstallMoonbase from '../components/InstallMoonbase.astro';
import Audio from '../components/Audio.astro';

import titleScreenshotImg from '../assets/scratchbaby-screenshot-crop.png';
import logoImg from '../assets/scratchbabylogo.png';


const bodyContent = `Part sampler, part performance instrument, completely fun.

Scratch Baby takes the fundamental behavior of a record being moved by hand and turns it into something you can configure, perform, and make your own. Slow it down, speed it up, scratch back and forth, or glide between pitches—all from your MIDI keyboard.

Under the hood, Scratch Baby gives you precise control over how every key activates the sample and jumps between playback speeds. It has immediacy and playability of a turntable without being confined to its limitations. 

See where it will take you..`;
---

<Layout title="Scratch Baby">
	<main class="product-page">
		<button class="cart-icon" onclick="Moonbase.view_cart()" aria-label="Open cart">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<path d="M16 10a4 4 0 0 1-8 0"></path>
			</svg>
		</button>

		<h1 class="sr-only">Scratch Baby</h1>

		<div class="screenshot-container">
			<Image src={logoImg} alt="" class="peek-logo" aria-hidden="true" />
			<div class="screenshot-wrapper">
				<Image
					src={titleScreenshotImg}
					alt="Scratch Baby plugin interface showing waveform display, slice controls, and per-voice knobs"
					class="screenshot"
					priority
				/>
			</div>
		</div>

		<p class="segment-title">Playable Turntable Sampler</p>

		<div class="content-section">
			<div class="video-wrapper">
				<iframe
					src="https://www.youtube.com/embed/PLd_091E9-0?si=kvYCM0v6Adwz33vM"
					title="Scratch Baby demo"
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				></iframe>
			</div>
			{bodyContent.split("\n").filter((content) => content.trim().length > 0).map((content) => <p>{content}</p>)}
		</div>
		<p class="segment-title">Examples</p>
		<div class="content-section">
		    <Audio
			id="onlyone"
			files={[
			    { title: "Alright!", subtitle: "Murder a sample", src: "/audio/alright.mp3" },
			    { title: "Ghosty", subtitle: "Emote a drone", src: "/audio/ghosty2.mp3" },
			    { title: "Horns", subtitle: "Hip-hop?", src: "/audio/horns.mp3" },
			    { title: "Heavyweight", subtitle: "Lofi jam", src: "/audio/heavyweight.mp3" },
			]}
		    />
		</div>

		<div class="buttons">
			<button class="btn btn-trial" onclick="Moonbase.download_product({ product_id: 'scratch-baby' })">
				Download Trial
			</button>
			<button class="btn btn-purchase" disabled onclick="Moonbase.add_to_cart({ product_id: 'scratch-baby', show_cart: true })">
				Purchase — <span data-moonbase-render="product.scratch-baby.price">TBD</span>
			</button>
		</div>
	</main>
	<InstallMoonbase/>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Shrikhand&display=swap');

	:root {
		--pink: #efa9da;
		--pink-tint: rgba(239, 169, 218, 0.1);
		--darkened-pink: #a86293;
		--dark: #1a2a35;
		--bg-color: #1e3241;
		--text-base: #e8e0d4;
		--text-body: #fbf1da;
		--yellow-shadow: #dfc47b;
		--btn-shadow: rgba(0, 0, 0, 0.3);
		--gradient-top: rgba(45, 65, 80, 0.4);
		--gradient-bottom: rgba(30, 50, 65, 0.6);
		--green: #49796b;
	}

	body {
	    background-color: #bcdcf3;
	}

	.product-page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 4rem 3rem;
		background:
			linear-gradient(180deg, var(--gradient-top) 0%, var(--gradient-bottom) 100%),
			url('/sky_background.jpg') center / cover no-repeat;
		background-color: var(--bg-color);
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		color: var(--text-base);
	}

	.cart-icon {
		position: fixed;
		top: -10px;
		right: 1.5rem;
		z-index: 100;
		background: var(--pink);
		color: var(--dark);
		border: 2px solid var(--dark);
		border-radius: 0 0 8px 8px;
		width: 2.5rem;
		height: 3rem;
		padding-top: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: transform 0.15s ease;
	}

	.cart-icon:hover {
		transform: translateY(4px);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.segment-title {
		font-family: 'Shrikhand', cursive;
		font-size: clamp(1.5rem, 4vw, 2.5rem);
		color: var(--pink);
		margin: 0 0 1.5rem;
		font-weight: 400;
		text-align: center;
		-webkit-text-stroke: 4px var(--dark);
		paint-order: stroke fill;
	}

	.screenshot-container {
		position: relative;
		width: 100%;
		max-width: 900px;
		margin-bottom: 1rem;
	}

	.peek-logo {
		position: absolute;
		bottom: 25%;
		left: 0;
		transform: translate(0%, 50%);
		width: 20vw;
		max-width: 8em;
		height: auto;
		z-index: 0;
		transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.screenshot-container:hover .peek-logo {
		transform: translate(-75%, 50%);
	}

	.screenshot-wrapper {
		position: relative;
		z-index: 1;
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
		border: 2px solid var(--dark);
		box-shadow:
			4px 4px 0px var(--yellow-shadow);
	}

	.screenshot {
		width: 100%;
		height: auto;
		display: block;
	}

	.video-wrapper {
		float: left;
		width: min(250px, 100%);
		aspect-ratio: 9 / 16;
		margin: 0 3rem 2rem 0;
		border-radius: 12px;
		overflow: hidden;
		border: 2px solid var(--dark);
		box-shadow:
			4px 4px 0px var(--yellow-shadow);
	}

	.video-wrapper iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	.content-section {
		max-width: 900px;
		width: 100%;
		margin-bottom: 3rem;
		line-height: 1.75;
	}

	.content-section::after {
		content: '';
		display: table;
		clear: both;
	}

	.content-section p {
		margin: 0 0 1.25rem;
		font-size: 1.1rem;
		color: var(--text-body);
	}

	.buttons {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 2rem;
		width: 100%;
		clear: both;
	}

	.btn {
		display: inline-block;
		padding: 1rem 2.5rem;
		margin: 0 1rem;
		border-radius: 8px;
		font-size: 1.1rem;
		font-weight: 700;
		text-decoration: none;
		border: none;
		cursor: pointer;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
		flex: 1;
		min-width: 15em;
		max-width: 20em;

		background: var(--pink);
		color: var(--dark);
		border: 2px solid var(--dark);
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px var(--btn-shadow);
	}
	.btn:disabled {
	    background: var(--darkened-pink);
	    cursor: default;
	}
	.btn:disabled:hover {
	    transform: none;
	    box-shadow: none;
	}

	.btn-purchase {
		position: relative;
		overflow: hidden;
	}
	.btn-purchase::after {
		content: "coming soon";
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-30%, -50%) rotate(30deg);
		background: var(--text-body);
		color: var(--dark);
		font-weight: 700;
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.35rem 0;
		width: 110%;
		text-align: center;
		white-space: nowrap;
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
		border-top: 2px solid var(--dark);
		border-bottom: 2px solid var(--dark);
	}

	@media (max-width: 500px) {
		.video-wrapper {
			float: none;
			margin: 0 auto 2rem;
		}
	}
</style>
