---
import { getImage } from 'astro:assets';
import logo from '@/assets/scratchbabylogo.png';
import '@/styles/base.css';
import InstallMoonbase from '@/components/InstallMoonbase.astro';

interface Props {
	title?: string;
}

const { title = 'Sundae Synth Co' } = Astro.props;
const favicon = await getImage({ src: logo, format: 'png' });
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={favicon.src} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<InstallMoonbase />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
